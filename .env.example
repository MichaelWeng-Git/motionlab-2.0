OPENAI_API_KEY=
FAL_KEY=
HF_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Where the 4.9 GB of on-device model weights are served from. Unset, the app
# reads public/models/, which is git-ignored and therefore does NOT deploy —
# leave it unset in production and every analysis fails. Point it at object
# storage + CDN with CORS enabled for this origin, and version the path so a
# weight file is never overwritten in place. See lib/model-url.ts.
NEXT_PUBLIC_MODEL_BASE=
